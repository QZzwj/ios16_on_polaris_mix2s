+/*
+ * Polaris GPU power-stage declarations. Kept in one header so both translation
+ * units see a prototype and the kernel stops warning about missing ones.
+ */
+#ifndef _BSD_DEV_POLARIS_GPU_PWR_H_
+#define _BSD_DEV_POLARIS_GPU_PWR_H_
+
+void polaris_gpu_pwr_probe(void);
+void polaris_gpu_cx_on(void);
+
+#endif /* _BSD_DEV_POLARIS_GPU_PWR_H_ */
diff --git a/bsd/dev/polaris_gpu_pwr_diag.c b/bsd/dev/polaris_gpu_pwr_diag.c
new file mode 100644
index 0000000..4052fe8
--- /dev/null
+++ b/bsd/dev/polaris_gpu_pwr_diag.c
@@ -0,0 +1,79 @@
+/*
+ * Polaris A630 GPUCC read-only power-state probe.
+ *
+ * Reads three documented registers inside the shared GPUCC/GFXCC window
+ * (0x05090000..0x05098fff) and prints them. No write, no vote, no GDSC transition,
+ * no firmware load. research/polaris/a630v2-bringup-contract.md requires read-only
+ * evidence of this kind before anything may be powered, and forbids flipping GX
+ * GDSCR by hand at all: GX must be requested through the GMU.
+ *
+ * Offsets are the documented ones, not guesses:
+ *   CX GDSCR   +0x106c
+ *   CX HW_CTRL +0x1540
+ *   GX GDSCR   +0x100c
+ *
+ * The mapping is deliberately kept for the life of the boot: nothing in this
+ * repository uses ml_io_unmap, and inventing an unmap call here would be a guess.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <pexpert/pexpert.h>
+#include <vm/pmap.h>
+#include <dev/polaris_gpu_pwr.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern bool polaris_touch_i2c_board(void);
+
+#define PG_GPUCC_BASE   0x05090000ull
+#define PG_GPUCC_WINDOW 0x9000ull
+
+/* One mapping covering 0x100c, 0x106c and 0x1540. */
+#define PG_GPUCC_MAP    (PG_GPUCC_BASE + 0x1000ull)
+#define PG_GPUCC_MAP_SZ 0x2000ull
+
+#if (PG_GPUCC_MAP + PG_GPUCC_MAP_SZ) > (PG_GPUCC_BASE + PG_GPUCC_WINDOW)
+#error "the GPUCC probe mapping would leave the documented window"
+#endif
+
+#define PG_CX_GDSCR     0x106cu
+#define PG_CX_HW_CTRL   0x1540u
+#define PG_GX_GDSCR     0x100cu
+
+static inline uint32_t
+pg_read32(volatile uint32_t *base, uint32_t off)
+{
+	return base[off / 4u];
+}
+
+void
+polaris_gpu_pwr_probe(void)
+{
+	vm_offset_t virt;
+	volatile uint32_t *regs;
+	int optin = 0;
+	uint32_t cx_gdscr, cx_ctrl, gx_gdscr;
+
+	if (!polaris_touch_i2c_board()) {
+		return;
+	}
+	(void)PE_parse_boot_argn("polarisgpupwr", &optin, sizeof(optin));
+	if (optin != 1) {
+		return;
+	}
+	virt = ml_io_map(PG_GPUCC_MAP, PG_GPUCC_MAP_SZ);
+	if (virt == 0) {
+		printf("POLARIS PWR: cannot map GPUCC; no values reported\n");
+		return;
+	}
+	regs = (volatile uint32_t *)virt;
+	/* Read-only: report what the boot loader left behind. */
+	cx_gdscr = pg_read32(regs, PG_CX_GDSCR);
+	cx_ctrl = pg_read32(regs, PG_CX_HW_CTRL);
+	gx_gdscr = pg_read32(regs, PG_GX_GDSCR);
+	printf("POLARIS PWR: read-only GPUCC cx_gdscr=0x%08x cx_hw_ctrl=0x%08x "
+	    "gx_gdscr=0x%08x (no vote, no GDSC write)\n", cx_gdscr, cx_ctrl, gx_gdscr);
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */

+ * 0120 bisection aid: make the console line and the persistent ring durable
+ * before the next GMU/SMMU register access. A wedged interconnect leaves no
+ * chance for the once-a-second log thread to flush, so every checkpoint is
+ * synchronously written to the sweetlog area.
+ */
+static void
+pg_sync_checkpoint(const char *tag)
+{
+	printf("POLARIS PWR: 0120 checkpoint %s\n", tag);
+	sweet_log_sync();
+}

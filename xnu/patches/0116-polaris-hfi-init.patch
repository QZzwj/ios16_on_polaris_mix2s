+static bool
+pg_hfi_alloc(void)
+{
+	vm_offset_t va = 0;
+	ppnum_t pn, max_pnum;
+	uint64_t pa;
+	kern_return_t kr;
+
+	if (pg_hfi.ready) {
+		return true;
+	}
+	max_pnum = (ppnum_t)((0x100000000ull >> PAGE_SHIFT) - 1ull);
+	kr = kmem_alloc_contig(kernel_map, &va, PG_HFI_ALLOC_SIZE, PAGE_MASK,
+	    max_pnum, 0, KMA_DATA | KMA_ZERO | KMA_PERMANENT,
+	    VM_KERN_MEMORY_IOKIT);
+	if (kr != KERN_SUCCESS || va == 0) {
+		printf("POLARIS PWR: HFI table allocation failed kr=%d\n", kr);
+		return false;
+	}
+	pn = pmap_find_phys(kernel_pmap, (addr64_t)va);
+	if (pn == 0) {
+		printf("POLARIS PWR: HFI table has no physical page\n");
+		return false;
+	}
+	pa = ptoa_64(pn);
+	if ((pa & 0xfffull) != 0 ||
+	    pa + PG_HFI_ALLOC_SIZE > 0x100000000ull) {
+		printf("POLARIS PWR: HFI table pa=0x%llx is not 4K-aligned "
+		    "below 4 GiB\n", pa);
+		return false;
+	}
+	pg_hfi.va = va;
+	pg_hfi.pa = pa;
+	pg_hfi.size = PG_HFI_ALLOC_SIZE;
+	pg_hfi_fill_table();
+	pg_hfi.ready = true;
+	printf("POLARIS PWR: HFI table allocated pa=0x%llx va=0x%llx size=%u\n",
+	    pa, (uint64_t)va, PG_HFI_ALLOC_SIZE);

+static bool
+pg_hfi_ctrl_init(void)
+{
+	uint32_t mask, status = 0;
+	unsigned int i;
+
+	mask = pg_rd32(pg_gmu_regs, PG_GMU_GMU2HOST_INTR_MASK);
+	pg_wr32(pg_gmu_regs, PG_GMU_GMU2HOST_INTR_MASK, mask & ~1u, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_HFI_CTRL_INIT, 1, 3);
+	for (i = 0; i < PG_HFI_CTRL_TIMEOUT_US / 1000u; i++) {
+		status = pg_rd32(pg_gmu_regs, PG_GMU_HFI_CTRL_STATUS);
+		if (status & 1u) {
+			break;
+		}
+		DELAY(1000);
+	}
+	if ((status & 1u) == 0) {
+		printf("POLARIS PWR: HFI CTRL_INIT timeout status=0x%08x "
+		    "mask=0x%08x qtbl_addr=0x%08x\n", status, mask,
+		    pg_rd32(pg_gmu_regs, PG_GMU_HFI_QTBL_ADDR));
+		return false;
+	}
+	pg_hfi.initialized = true;
+	printf("POLARIS PWR: HFI ctrl initialized status=0x%08x mask=0x%08x\n",
+	    status, mask & ~1u);
+	return true;

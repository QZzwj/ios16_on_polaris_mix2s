+		printf("POLARIS PWR: HFI not ready; GMU boot or CTRL_INIT missing\n");
+		return 0;
+	}
+	table = (uint32_t *)pg_hfi.va;
+
+	table[PG_HFI_CMD_DATA_DWORD + 0] = PG_HFI_INIT_HDR;
+	table[PG_HFI_CMD_DATA_DWORD + 1] = 0;
+	table[PG_HFI_CMD_DATA_DWORD + 2] = (uint32_t)(pg_hfi.pa +
+	    PG_HFI_TABLE_SIZE);
+	table[PG_HFI_CMD_DATA_DWORD + 3] = PG_HFI_DBG_SIZE;
+	table[PG_HFI_CMD_DATA_DWORD + 4] = 1;
+	table[PG_HFI_CMD_WRITE_INDEX] = 5;
+	__sync_synchronize();
+	pg_hfi_flush();
+	__sync_synchronize();
+	pg_wr32(pg_gmu_regs, PG_GMU_HOST2GMU_INTR_SET, 1, 3);
+	printf("POLARIS PWR: HFI INIT sent cmd=0x%08x dbg=0x%08x\n",
+	    PG_HFI_INIT_HDR, table[PG_HFI_CMD_DATA_DWORD + 2]);
+
+	for (i = 0; i < PG_HFI_ACK_TIMEOUT_US / 1000u; i++) {
+		info = pg_rd32(pg_gmu_regs, PG_GMU_GMU2HOST_INTR_INFO);
+		if (info & 1u) {
+			break;
+		}
+		DELAY(1000);
+	}
+	if ((info & 1u) == 0) {
+		printf("POLARIS PWR: HFI ACK timeout info=0x%08x\n", info);
+		return 0;
+	}
+	pg_wr32(pg_gmu_regs, PG_GMU_GMU2HOST_INTR_CLR, 1, 3);
+	__sync_synchronize();
+	pg_hfi_flush();
+	__sync_synchronize();
+
+	rd = table[PG_HFI_MSG_READ_INDEX];
+	wr = table[PG_HFI_MSG_WRITE_INDEX];
+	if (rd >= PG_HFI_Q_DWORDS || wr >= PG_HFI_Q_DWORDS || rd == wr) {
+		printf("POLARIS PWR: HFI ACK invalid msg queue rd=%u wr=%u\n",
+		    rd, wr);
+		return 0;
+	}
+	hdr = table[PG_HFI_MSG_DATA_DWORD + rd];
+	size = (hdr >> 8) & 0xffu;
+	if (size != PG_HFI_ACK_WORDS) {
+		printf("POLARIS PWR: HFI ACK invalid hdr=0x%08x size=%u\n",
+		    hdr, size);
+		return 0;
+	}
+	for (i = 0; i < size; i++) {
+		ack[i] = table[PG_HFI_MSG_DATA_DWORD +
+		    ((rd + i) % PG_HFI_Q_DWORDS)];
+	}
+	table[PG_HFI_MSG_READ_INDEX] = (rd + size) % PG_HFI_Q_DWORDS;
+	__sync_synchronize();
+	pg_hfi_flush();
+
+	if ((ack[0] & 0xffu) != PG_HFI_ACK_ID ||
+	    ((ack[0] >> 8) & 0xffu) != PG_HFI_ACK_WORDS ||
+	    ((ack[0] >> 16) & 0xffu) != PG_HFI_ACK_TYPE ||
+	    ack[1] != PG_HFI_INIT_HDR) {
+		printf("POLARIS PWR: HFI ACK invalid hdr=0x%08x ret=0x%08x\n",
+		    ack[0], ack[1]);
+		return 0;
+	}
+	error = ack[2];
+	if (error != 0) {
+		printf("POLARIS PWR: HFI ACK error=%u\n", error);
+		return 0;
+	}
+	pg_hfi.ack_done = true;
+	printf("POLARIS PWR: HFI ACK id=126 size=19 seq=1 error=0 "
+	    "payload0=0x%08x\n", ack[3]);
+	return 1;
+}

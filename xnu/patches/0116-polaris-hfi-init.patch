+/*
+ * Build the three queue headers used by the A630 GMU firmware. The queue
+ * addresses are physical because no SMMU stage-1 mapping exists yet.
+ */
+static void
+pg_hfi_fill_table(void)
+{
+	static const uint32_t types[PG_HFI_Q_COUNT] = {
+		PG_HFI_CMD_TYPE, PG_HFI_MSG_TYPE, PG_HFI_DBG_TYPE
+	};
+	uint32_t *table = (uint32_t *)pg_hfi.va;
+	unsigned int i;
+
+	memset(table, 0, PG_HFI_ALLOC_SIZE);
+	table[0] = 0;
+	table[1] = PG_HFI_TABLE_DWORDS;
+	table[2] = PG_HFI_HDR_DWORDS;
+	table[3] = PG_HFI_QHDR_DWORDS;
+	table[4] = PG_HFI_Q_COUNT;
+	table[5] = PG_HFI_Q_COUNT;
+
+	for (i = 0; i < PG_HFI_Q_COUNT; i++) {
+		uint32_t base = PG_HFI_HDR_DWORDS + i * PG_HFI_QHDR_DWORDS;
+		uint32_t offset = PG_HFI_Q0_OFFSET + i * PG_HFI_Q_STRIDE;
+
+		table[base + 0] = PG_HFI_Q_STATUS_ACTIVE;
+		table[base + 1] = (uint32_t)(pg_hfi.pa + offset);
+		table[base + 2] = types[i];
+		table[base + 3] = PG_HFI_Q_DWORDS;
+		table[base + 4] = 0;
+		table[base + 5] = 0;
+		table[base + 6] = 1;
+		table[base + 7] = 1;
+		table[base + 8] = 1;
+		table[base + 9] = 0;
+		table[base + 10] = 0;
+		table[base + 11] = 0;
+	}
+	__sync_synchronize();
+	pg_hfi_flush();
+}

diff --git a/bsd/dev/polaris_gpu_pwr.h b/bsd/dev/polaris_gpu_pwr.h
index 086cfc6..f750f71 100644
--- a/bsd/dev/polaris_gpu_pwr.h
+++ b/bsd/dev/polaris_gpu_pwr.h
@@ -47,4 +47,15 @@ void polaris_gpu_bus_exit(void);
  */
 int polaris_gpu_gmu_enter(void);
 
+/*
+ * SMMU probe stage: map the GPU SMMU register file (0x05040000 + 0x10000)
+ * read-only and record the global identification and per-context-bank
+ * configuration. Requires the CX domain, clocks and bus owned above. This
+ * stage does not program SMR/S2CR, does not install page tables and claims
+ * no domain or firmware: a readable SMMU only proves the interconnect
+ * reaches it. Access is staged behind the separate `polarissmmu` opt-in:
+ * 0 (default) never maps the window, 1..4 read progressively further.
+ */
+int polaris_gpu_smmu_probe(void);
+
 #endif /* _BSD_DEV_POLARIS_GPU_PWR_H_ */
diff --git a/bsd/dev/polaris_gpu_pwron.c b/bsd/dev/polaris_gpu_pwron.c
index 37c407b..6bad450 100644
--- a/bsd/dev/polaris_gpu_pwron.c
+++ b/bsd/dev/polaris_gpu_pwron.c
@@ -148,6 +148,47 @@ extern bool polaris_touch_i2c_board(void);
 #error "the GMU register constants would leave the documented CSR window"
 #endif
 
+/*
+ * GPU SMMU (arm,smmu-kgsl@5040000), vendor DTS <0x05040000 0x10000>.
+ * This is an ARM SMMU-500 register file: GR0 at +0x0000, GR1 (the CBAR
+ * array) at +(1 << pgshift), and the context banks at +0x8000 with the
+ * same stride. qcom,protect=<0x40000 0xc000> is relative to a different
+ * aperture covering the HYP-owned CB5-CB7 and is never mapped here.
+ * Every access in this revision is a read.
+ */
+#define PG_SMMU_BASE            0x05040000ull
+#define PG_SMMU_WINDOW          0x10000u
+#define PG_SMMU_CB_BASE         (PG_SMMU_WINDOW / 2u)
+#define PG_SMMU_MAX_LEVEL       4
+
+#define PG_SMMU_IDR0            0x020u
+#define PG_SMMU_IDR1            0x024u
+#define PG_SMMU_IDR2            0x028u
+#define PG_SMMU_IDR3            0x02cu
+#define PG_SMMU_IDR5            0x034u
+#define PG_SMMU_IDR6            0x038u
+#define PG_SMMU_IDR7            0x03cu
+#define PG_SMMU_GFAR            0x040u
+#define PG_SMMU_GFSR            0x048u
+#define PG_SMMU_GFSYNR0         0x050u
+#define PG_SMMU_GFSYNR1         0x054u
+#define PG_SMMU_SMR(n)          (0x800u + ((n) * 4u))
+#define PG_SMMU_S2CR(n)         (0xc00u + ((n) * 4u))
+#define PG_SMMU_CB_FSR          0x058u
+
+#define PG_SMMU_IDR0_NUMSMRG_SHIFT  0
+#define PG_SMMU_IDR0_NUMSMRG_MASK   0xffu
+#define PG_SMMU_IDR0_NUMSIDB_SHIFT  9
+#define PG_SMMU_IDR0_NUMSIDB_MASK   0xfu
+#define PG_SMMU_IDR0_NUMIRPT_SHIFT  16
+#define PG_SMMU_IDR0_NUMIRPT_MASK   0xffu
+#define PG_SMMU_IDR1_PAGESIZE       (1u << 31)
+#define PG_SMMU_IDR1_NUMCB_SHIFT    0
+#define PG_SMMU_IDR1_NUMCB_MASK     0xffu
+#define PG_SMMU_S2CR_TYPE_SHIFT     16
+#define PG_SMMU_S2CR_TYPE_MASK      0x3u
+#define PG_SMMU_S2CR_CBNDX_MASK     0xffu
+
 /*
  * Fabia PLL register offsets, from clk-alpha-pll.c (CAF msm-4.9 and
  * mainline agree on the Fabia table). PLL_MODE carries PLL_OUTCTRL(0),
@@ -195,6 +236,7 @@ static volatile uint32_t *pg_pll_regs;
 static volatile uint32_t *pg_gcc_axi_regs;
 static volatile uint32_t *pg_gcc_gfx_regs;
 static volatile uint32_t *pg_gmu_regs;
+static volatile uint32_t *pg_smmu_regs;
 static uint32_t pg_cx_saved;
 static int pg_cx_owned;
 
@@ -322,6 +364,23 @@ pg_gmu_map(void)
 	return true;
 }
 
+static bool
+pg_smmu_map(void)
+{
+	vm_offset_t virt;
+
+	if (pg_smmu_regs != NULL) {
+		return true;
+	}
+	virt = ml_io_map(PG_SMMU_BASE, PG_SMMU_WINDOW);
+	if (virt == 0) {
+		printf("POLARIS PWR: cannot map SMMU; probe skipped\n");
+		return false;
+	}
+	pg_smmu_regs = (volatile uint32_t *)virt;
+	return true;
+}
+
 int
 polaris_gpu_rails_enter(void)
 {
@@ -909,6 +968,137 @@ polaris_gpu_gmu_enter(void)
 	return 1;
 }
 
+/*
+ * Map the GPU SMMU register file and record what the vendor firmware left
+ * behind. No SMR, S2CR, CBAR, SCTLR or TLB register is written and no page
+ * table is installed.
+ *
+ * The first version of this probe read every identification register in one
+ * burst and the machine stopped responding before sweetlog could flush a
+ * single line. The probe is now staged behind its own `polarissmmu` opt-in and
+ * prints one line immediately before every read:
+ *
+ *   0 (default): do not map or read anything;
+ *   1: IDR0 only;
+ *   2: IDR0..IDR3;
+ *   3: IDR0..IDR7 and the global fault registers;
+ *   4: additionally every context-bank CBAR/SMR/S2CR/FSR.
+ *
+ * The last "SMMU read begin" line in the persistent ring therefore names the
+ * exact register that did not answer. The context-bank geometry is derived
+ * from IDR1 the same way arm-smmu.c derives it; a geometry that would leave
+ * the 64 KiB aperture is refused instead of guessed. Stream IDs are printed
+ * raw: the DT routes SID 0x208 with mask 0x7 across the four GPU domains, but
+ * this probe does not claim or reprogram that routing.
+ */
+static uint32_t
+pg_smmu_read(uint32_t off, unsigned int level)
+{
+	printf("POLARIS PWR: SMMU read begin off=0x%03x level=%u\n", off, level);
+	return pg_rd32(pg_smmu_regs, off);
+}
+
+int
+polaris_gpu_smmu_probe(void)
+{
+	uint32_t idr0 = 0, idr1 = 0, idr2 = 0, idr3 = 0;
+	uint32_t idr5 = 0, idr6 = 0, idr7 = 0;
+	uint32_t gfar = 0, gfsr = 0, gfsynr0 = 0, gfsynr1 = 0;
+	uint32_t num_cb = 0, num_smr, num_irpt, sid_bits;
+	uint32_t pgshift = 12u, cb_stride, cb_base, n;
+	const char *granule = "unknown";
+	int level = 0;
+
+	if (!pg_cx_owned || !pg_clk_owned || !pg_bus_owned ||
+	    pg_cx_regs == NULL) {
+		printf("POLARIS PWR: smmu refused; bus not owned\n");
+		return 0;
+	}
+	(void)PE_parse_boot_argn("polarissmmu", &level, sizeof(level));
+	if (level <= 0) {
+		printf("POLARIS PWR: smmu probe not opted in; no access\n");
+		return 0;
+	}
+	if (level > PG_SMMU_MAX_LEVEL) {
+		level = PG_SMMU_MAX_LEVEL;
+	}
+	printf("POLARIS PWR: SMMU probe level=%d; read-only\n", level);
+	if (!pg_smmu_map()) {
+		return 0;
+	}
+
+	idr0 = pg_smmu_read(PG_SMMU_IDR0, 1);
+	num_smr = (idr0 >> PG_SMMU_IDR0_NUMSMRG_SHIFT) &
+	    PG_SMMU_IDR0_NUMSMRG_MASK;
+	num_irpt = (idr0 >> PG_SMMU_IDR0_NUMIRPT_SHIFT) &
+	    PG_SMMU_IDR0_NUMIRPT_MASK;
+	sid_bits = (idr0 >> PG_SMMU_IDR0_NUMSIDB_SHIFT) &
+	    PG_SMMU_IDR0_NUMSIDB_MASK;
+	printf("POLARIS PWR: SMMU IDR0=0x%08x\n", idr0);
+
+	if (level >= 2) {
+		idr1 = pg_smmu_read(PG_SMMU_IDR1, 2);
+		idr2 = pg_smmu_read(PG_SMMU_IDR2, 2);
+		idr3 = pg_smmu_read(PG_SMMU_IDR3, 2);
+		printf("POLARIS PWR: SMMU IDR1=0x%08x IDR2=0x%08x IDR3=0x%08x\n",
+		    idr1, idr2, idr3);
+		num_cb = (idr1 >> PG_SMMU_IDR1_NUMCB_SHIFT) &
+		    PG_SMMU_IDR1_NUMCB_MASK;
+		pgshift = (idr1 & PG_SMMU_IDR1_PAGESIZE) ? 16u : 12u;
+		granule = (pgshift == 16u) ? "64K" : "4K";
+	}
+	if (level >= 3) {
+		idr5 = pg_smmu_read(PG_SMMU_IDR5, 3);
+		idr6 = pg_smmu_read(PG_SMMU_IDR6, 3);
+		idr7 = pg_smmu_read(PG_SMMU_IDR7, 3);
+		gfar = pg_smmu_read(PG_SMMU_GFAR, 3);
+		gfsr = pg_smmu_read(PG_SMMU_GFSR, 3);
+		gfsynr0 = pg_smmu_read(PG_SMMU_GFSYNR0, 3);
+		gfsynr1 = pg_smmu_read(PG_SMMU_GFSYNR1, 3);
+		printf("POLARIS PWR: SMMU IDR5=0x%08x IDR6=0x%08x IDR7=0x%08x\n",
+		    idr5, idr6, idr7);
+		printf("POLARIS PWR: SMMU GFAR=0x%08x GFSR=0x%08x GFSYNR0=0x%08x "
+		    "GFSYNR1=0x%08x\n", gfar, gfsr, gfsynr0, gfsynr1);
+	}
+
+	cb_stride = 1u << pgshift;
+	cb_base = PG_SMMU_CB_BASE;
+	if (level >= 2 && (num_cb == 0 || num_cb > 8 || num_smr == 0 ||
+	    num_smr > 32 || cb_base + (num_cb * cb_stride) > PG_SMMU_WINDOW)) {
+		printf("POLARIS PWR: SMMU IDR is not usable (idr0=0x%08x "
+		    "idr1=0x%08x); probe refused\n", idr0, idr1);
+		return 0;
+	}
+
+	if (level >= 4) {
+		for (n = 0; n < num_cb; n++) {
+			uint32_t cbar, smr, s2cr, fsr, type;
+
+			cbar = pg_smmu_read(cb_stride + (n * 4u), 4);
+			smr = pg_smmu_read(PG_SMMU_SMR(n), 4);
+			s2cr = pg_smmu_read(PG_SMMU_S2CR(n), 4);
+			fsr = pg_smmu_read(cb_base + (n * cb_stride) +
+			    PG_SMMU_CB_FSR, 4);
+			type = (s2cr >> PG_SMMU_S2CR_TYPE_SHIFT) &
+			    PG_SMMU_S2CR_TYPE_MASK;
+			printf("POLARIS PWR: SMMU CB%u CBAR=0x%08x SMR=0x%08x "
+			    "S2CR=0x%08x type=%s cbndx=%u FSR=0x%08x\n", n,
+			    cbar, smr, s2cr,
+			    type == 0 ? "trans" : (type == 1 ? "bypass" :
+			    (type == 2 ? "fault" : "reserved")),
+			    s2cr & PG_SMMU_S2CR_CBNDX_MASK, fsr);
+		}
+	} else {
+		printf("POLARIS PWR: SMMU probe limited to level %d; "
+		    "context banks not read\n", level);
+	}
+
+	printf("POLARIS PWR: SMMU read-only; level=%d contexts=%u smr=%u "
+	    "sid_bits=%u irpt=%u granule=%s; no attach\n",
+	    level, num_cb, num_smr, sid_bits, num_irpt, granule);
+	return 1;
+}
+

+static uint32_t
+pg_gmu_cm3_fault_probe(const char *tag)
+{
+	uint32_t info = pg_rd32(pg_gmu_regs, PG_GMU_GMU2HOST_INTR_INFO);
+	uint32_t after = 0;
+
+	if ((info & PG_GMU_CM3_FAULT_MASK) != 0) {
+		pg_wr32(pg_gmu_regs, PG_GMU_GMU2HOST_INTR_CLR,
+		    PG_GMU_CM3_FAULT_MASK, 3);
+		after = pg_rd32(pg_gmu_regs, PG_GMU_GMU2HOST_INTR_INFO);
+		printf("POLARIS PWR: CM3 fault %s info=0x%08x after_clr=0x%08x "
+		    "init=0x%08x busy=0x%08x cfg=0x%08x\n",
+		    tag, info, after,

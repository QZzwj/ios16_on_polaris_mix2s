+/*
+ * Platform carve-outs adjacent to the low-DRAM hole used for the HFI table.
+ * These come from this handset's recovery FDT reserved-memory nodes. The
+ * first candidate address (0x8bf80000) sat inside camera_region, so the
+ * kernel must refuse any HFI reservation that touches one of these ranges.
+ */
+#define PG_CAMERA_BASE  0x8bf00000ull
+#define PG_CAMERA_SIZE  0x500000ull
+#define PG_IPS_BASE     0x8c400000ull
+#define PG_IPS_SIZE     0x10000ull
+#define PG_IPA_BASE     0x8c410000ull
+#define PG_IPA_SIZE     0x5000ull
+#define PG_ADSP_BASE    0x8c500000ull
+#define PG_ADSP_SIZE    0x1e00000ull
+#define PG_WLAN_BASE    0x8e300000ull
+#define PG_WLAN_SIZE    0x100000ull
+
+static const struct pg_range {
+	uint64_t base;
+	uint64_t size;
+} pg_carveouts[] = {
+	{ PG_CAMERA_BASE, PG_CAMERA_SIZE },
+	{ PG_IPS_BASE,    PG_IPS_SIZE },
+	{ PG_IPA_BASE,    PG_IPA_SIZE },
+	{ PG_ZAP_BASE,    PG_ZAP_SIZE },
+	{ PG_ADSP_BASE,   PG_ADSP_SIZE },
+	{ PG_WLAN_BASE,   PG_WLAN_SIZE },
+	{ PG_SPLASH_BASE, PG_SPLASH_SIZE },
+};
 

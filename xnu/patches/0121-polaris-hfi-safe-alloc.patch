+/*
+ * 0121: the HFI table is mapped with ml_io_map(), i.e. Device memory.
+ * memset() is allowed to use DC ZVA for large zeroing, which is not
+ * architecturally safe on Device mappings. Clear with volatile 32-bit
+ * stores instead so every word becomes a normal device write.
+ */
+static void
+pg_hfi_zero_table(void)
+{
+	volatile uint32_t *p = (volatile uint32_t *)pg_hfi.va;
+	uint32_t i;

+/*
+ * Return PLL1 to the exact state saved before this driver touched it.
+ * Disable the output and stop the PLL first so no consumer sees the
+ * intermediate L/FRAC writes, then restore the original registers in the
+ * reverse order of the enable sequence.
+ */
+static void
+pg_pll_restore(const char *why)
+{
+	uint32_t mode;
+
+	if (!pg_pll_owned || pg_pll_regs == NULL) {
+		return;
+	}
+	mode = pg_rd32(pg_pll_regs, PG_PLL_MODE);
+	pg_wr32(pg_pll_regs, PG_PLL_MODE, mode & ~PG_PLL_OUTCTRL, 1);
+	pg_wr32(pg_pll_regs, PG_PLL_OPMODE, PG_PLL_STANDBY, 1);
+	pg_wr32(pg_pll_regs, PG_PLL_L_VAL, pg_pll_saved.l, 1);
+	pg_wr32(pg_pll_regs, PG_PLL_FRAC_VAL, pg_pll_saved.frac, 1);
+	pg_wr32(pg_pll_regs, PG_PLL_USER_CTL, pg_pll_saved.user_ctl, 1);
+	pg_wr32(pg_pll_regs, PG_PLL_USER_CTL_U, pg_pll_saved.user_ctl_u, 1);
+	pg_wr32(pg_pll_regs, PG_PLL_CONFIG_CTL, pg_pll_saved.config_ctl, 1);
+	pg_wr32(pg_pll_regs, PG_PLL_CONFIG_CTL_U, pg_pll_saved.config_ctl_u, 1);
+	pg_wr32(pg_pll_regs, PG_PLL_TEST_CTL, pg_pll_saved.test_ctl, 1);
+	pg_wr32(pg_pll_regs, PG_PLL_TEST_CTL_U, pg_pll_saved.test_ctl_u, 1);
+	pg_wr32(pg_pll_regs, PG_PLL_OPMODE, pg_pll_saved.opmode, 1);
+	pg_wr32(pg_pll_regs, PG_PLL_MODE, pg_pll_saved.mode, 1);
+	pg_pll_owned = 0;
+	printf("POLARIS PWR: PLL1 %s; restored mode=0x%08x opmode=0x%08x "
+	    "l=0x%08x frac=0x%08x\n", why,
+	    pg_rd32(pg_pll_regs, PG_PLL_MODE),
+	    pg_rd32(pg_pll_regs, PG_PLL_OPMODE),
+	    pg_rd32(pg_pll_regs, PG_PLL_L_VAL),
+	    pg_rd32(pg_pll_regs, PG_PLL_FRAC_VAL));
+}
+
+/*
+ * Configure the Fabia GPUCC PLL1 to 500 MHz and bring its main output up.
+ * This is the same sequence as clk_fabia_pll_configure() followed by
+ * clk_fabia_pll_enable() in the vendor clock driver: program L/FRAC, set
+ * UPDATE_BYPASS and RESET_N, move OPMODE from standby to run, wait for
+ * LOCK_DET, enable the main outputs and assert OUTCTRL.
+ *
+ * Returns 1 when PLL1 is locked at 500 MHz. Returns 0 when the page cannot
+ * be mapped, the FSM owns the PLL, or lock does not arrive; in the latter
+ * two cases every saved register is restored before returning so the caller
+ * can fall back to GPLL0 without leaving a half-programmed PLL behind.
+ */
+static int
+pg_pll1_enter(void)
+{
+	struct pg_pll_state st;
+	uint32_t mode, user;
+	unsigned int i;
+
+	if (!pg_pll_map()) {
+		return 0;
+	}
+	pg_pll_read(&st);
+	printf("POLARIS PWR: PLL1 enter mode=0x%08x opmode=0x%08x "
+	    "l=0x%08x frac=0x%08x user_ctl=0x%08x config_ctl=0x%08x\n",
+	    st.mode, st.opmode, st.l, st.frac, st.user_ctl, st.config_ctl);
+	if ((st.mode & PG_PLL_LOCK_DET) && (st.opmode & PG_PLL_RUN) &&
+	    (st.mode & PG_PLL_OUTCTRL) && st.l == PG_PLL1_L_VAL &&
+	    (st.frac & 0xffffu) == PG_PLL1_FRAC_VAL) {
+		printf("POLARIS PWR: PLL1 already running at 500 MHz; "
+		    "left untouched\n");
+		return 1;
+	}
+	if (st.mode & PG_PLL_FSM_ENA) {
+		printf("POLARIS PWR: PLL1 FSM is enabled but PLL is not at "
+		    "500 MHz; refusing to fight the FSM\n");
+		return 0;
+	}
+
+	pg_pll_saved = st;
+	pg_pll_owned = 1;
+
+	/* Stop the output, park in standby, then program the rate. */
+	mode = st.mode & ~PG_PLL_OUTCTRL;
+	pg_wr32(pg_pll_regs, PG_PLL_MODE, mode, 1);
+	pg_wr32(pg_pll_regs, PG_PLL_OPMODE, PG_PLL_STANDBY, 1);
+	pg_wr32(pg_pll_regs, PG_PLL_L_VAL, PG_PLL1_L_VAL, 1);
+	pg_wr32(pg_pll_regs, PG_PLL_FRAC_VAL, PG_PLL1_FRAC_VAL, 1);
+	pg_wr32(pg_pll_regs, PG_PLL_MODE,
+	    mode | PG_PLL_UPDATE_BYPASS | PG_PLL_RESET_N, 1);
+	pg_wr32(pg_pll_regs, PG_PLL_OPMODE, PG_PLL_RUN, 1);
+	for (i = 0; i < PG_PLL_POLL_US; i++) {
+		if (pg_rd32(pg_pll_regs, PG_PLL_MODE) & PG_PLL_LOCK_DET) {
+			break;
+		}
+		DELAY(1);
+	}
+	if (i == PG_PLL_POLL_US) {
+		printf("POLARIS PWR: PLL1 lock timeout after %u polls "
+		    "(mode=0x%08x opmode=0x%08x)\n", PG_PLL_POLL_US,
+		    pg_rd32(pg_pll_regs, PG_PLL_MODE),
+		    pg_rd32(pg_pll_regs, PG_PLL_OPMODE));
+		pg_pll_restore("lock timeout");
+		return 0;
+	}
+
+	/* Enable the three Fabia main outputs, then PLL_OUTCTRL. */
+	user = pg_rd32(pg_pll_regs, PG_PLL_USER_CTL);
+	pg_wr32(pg_pll_regs, PG_PLL_USER_CTL, user | PG_PLL_OUT_MASK, 1);
+	mode = pg_rd32(pg_pll_regs, PG_PLL_MODE);
+	pg_wr32(pg_pll_regs, PG_PLL_MODE, mode | PG_PLL_OUTCTRL, 1);
+	mode = pg_rd32(pg_pll_regs, PG_PLL_MODE);
+	if (!(mode & PG_PLL_LOCK_DET) || !(mode & PG_PLL_OUTCTRL)) {
+		printf("POLARIS PWR: PLL1 readback lost lock or output "
+		    "(mode=0x%08x)\n", mode);
+		pg_pll_restore("readback failure");
+		return 0;
+	}
+	printf("POLARIS PWR: PLL1 locked after %u polls; mode=0x%08x "
+	    "opmode=0x%08x l=0x%08x frac=0x%08x\n", i + 1,
+	    mode, pg_rd32(pg_pll_regs, PG_PLL_OPMODE),
+	    pg_rd32(pg_pll_regs, PG_PLL_L_VAL),
+	    pg_rd32(pg_pll_regs, PG_PLL_FRAC_VAL));
+	return 1;
+}
+
+static void
+pg_pll1_exit(void)
+{
+	pg_pll_restore("exit");
+}

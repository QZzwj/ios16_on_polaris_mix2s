diff --git a/bsd/dev/polaris_gpu_validate.c b/bsd/dev/polaris_gpu_validate.c
index bdc9457..c4fd072 100644
--- a/bsd/dev/polaris_gpu_validate.c
+++ b/bsd/dev/polaris_gpu_validate.c
@@ -20,6 +20,15 @@ extern bool polaris_touch_i2c_board(void);
 #define PG_SPLASH_BASE 0x9d400000ull
 #define PG_SPLASH_SIZE 0x2400000ull
 
+/*
+ * The HFI queue table must live below 4 GiB because the A630 GMU reads its
+ * queue addresses as 32-bit physical addresses. This XNU instance manages
+ * only the upper DDR bank (dram-base is 0x100000000), so kmem_alloc_contig
+ * cannot provide such a page: the reservation comes from the boot ADT.
+ */
+#define PG_HFI_MIN_SIZE 0x8000ull
+#define PG_HFI_LIMIT    0x100000000ull
+
 static const char *const pg_blob_name[PG_BLOB_COUNT] = {
 	"GPU-SQE", "GPU-GMU", "GPU-ZAP-MDT",
 	"GPU-ZAP-B00", "GPU-ZAP-B01", "GPU-ZAP-B02",
@@ -206,6 +215,41 @@ pg_validate_handoff(struct pg_handoff *out, const char **reason)
 			}
 		}
 	}
+
+	/*
+	 * Optional low-DRAM HFI reservation. It is not part of the registered
+	 * firmware set and absence is not an error, but when present every
+	 * property is enforced: 4 KiB alignment, at least the 32 KiB table,
+	 * entirely below 4 GiB, and no overlap with XNU-managed RAM or any
+	 * carve-out this driver knows about. The kernel maps it with
+	 * ml_io_map(); no allocator ever hands out memory from this range.
+	 */
+	{
+		uint64_t addr = 0, size = 0;
+
+		if (pg_pair(mmap, "GPU-HFI", &addr, &size)) {
+			if (size < PG_HFI_MIN_SIZE || size > UINT32_MAX) {
+				*reason = "GPU-HFI reservation has an invalid length";
+				return false;
+			}
+			if (addr == 0 || (addr & 0xfffull) != 0) {
+				*reason = "GPU-HFI reservation is not 4K aligned";
+				return false;
+			}
+			if (addr > UINT64_MAX - size || addr + size > PG_HFI_LIMIT) {
+				*reason = "GPU-HFI reservation leaves low 4 GiB";
+				return false;
+			}
+			if (pg_overlap(addr, size, out->dram_base, out->dram_size) ||
+			    pg_overlap(addr, size, PG_ZAP_BASE, PG_ZAP_SIZE) ||
+			    pg_overlap(addr, size, PG_SPLASH_BASE, PG_SPLASH_SIZE)) {
+				*reason = "GPU-HFI reservation collides with managed RAM or a carve-out";
+				return false;
+			}
+			out->hfi_addr = addr;
+			out->hfi_size = (uint32_t)size;
+		}
+	}
 	return true;
 }
 

--- a/bsd/dev/polaris_gpu_pwron.c
+++ b/bsd/dev/polaris_gpu_pwron.c
@@ -1,14 +1,20 @@
 /*
- * Polaris A630 CX power-domain request -- the first step that writes hardware.
+ * Polaris A630 CX power-domain request -- the rails-stage backend.
  *
  * Scope, deliberately narrow:
  *   - only CX GDSCR at GPUCC+0x106c;
  *   - only bit 0 (SW_COLLAPSE), cleared to request power, with every other bit
  *     preserved by a read-modify-write;
- *   - bounded polling of PWR_ON (bit 31) with a read iteration budget instead of a
- *     timer, because no delay primitive is in use anywhere in this driver set;
- *   - on timeout the original register value is written back and the caller is told
- *     the request failed;
+ *   - only after the caller reached the rails stage and only with the separate
+ *     `polarisgpuon=1` opt-in;
+ *   - bounded polling of PWR_ON (bit 31) with a 1 us delay and a finite
+ *     iteration budget mirroring the vendor driver's 100 us budget;
+ *   - PWR_ON already set before the write means foreign ownership: observe,
+ *     never write, never claim;
+ *   - on timeout the original register value is written back and the caller is
+ *     told the request failed;
+ *   - a successful enter records the original value; exit restores it exactly
+ *     and is a no-op unless enter succeeded;
  *   - GX GDSCR is never touched: a630v2-bringup-contract.md requires GX to be
  *     requested through the GMU.
  *
@@ -16,10 +22,6 @@
  *   PWR_ON_MASK = BIT(31), SW_COLLAPSE_MASK = BIT(0), HW_CONTROL_MASK = BIT(1),
  *   SW_OVERRIDE_MASK = BIT(2). gdsc_enable() clears SW_COLLAPSE and polls PWR_ON
  *   with a 100 us budget; that is the sequence mirrored here.
- *
- * A PWR_ON bit that is already set is reported as foreign/unknown ownership. Per the
- * contract, observing PWR_ON is not acquiring the domain, so nothing is claimed and
- * no vote is recorded.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 
@@ -27,6 +29,7 @@
 #include <sys/systm.h>
 #include <pexpert/pexpert.h>
 #include <vm/pmap.h>
+#include <machine/machine_routines.h>
 #include <dev/polaris_gpu_pwr.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
@@ -47,8 +50,17 @@ extern bool polaris_touch_i2c_board(void);
 #define PG_GDSCR_PWR_ON       (1u << 31)

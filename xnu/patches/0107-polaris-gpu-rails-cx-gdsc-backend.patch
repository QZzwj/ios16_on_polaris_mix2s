-#define PG_POLL_READS 2000u
+/* Bounded poll budget: 200 iterations of a 1 us delay. */
+#define PG_POLL_US 200u
+
+static volatile uint32_t *pg_cx_regs;
+static uint32_t pg_cx_saved;
+static int pg_cx_owned;
+
+#ifdef PG_PWR_TEST
+extern void pg_pwr_test_after_write(uint32_t, uint32_t);
+void pg_pwr_test_reset(void);

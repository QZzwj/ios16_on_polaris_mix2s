 {
 	base[off / 4u] = value;
+#ifdef PG_PWR_TEST
+	pg_pwr_test_after_write(off, value);
+#endif
 }
 
-void
-polaris_gpu_cx_on(void)
+static bool
+pg_cx_map(void)
 {
 	vm_offset_t virt;
-	volatile uint32_t *regs;
+
+	if (pg_cx_regs != NULL) {
+		return true;

+	after = pg_rd32(pg_cx_regs, PG_CX_GDSCR);
+	pg_wr32(pg_cx_regs, PG_CX_GDSCR, before);
+	restored = pg_rd32(pg_cx_regs, PG_CX_GDSCR);
+	printf("POLARIS PWR: rails enter timed out after %u polls "

diff --git a/bsd/dev/polaris_gpu.c b/bsd/dev/polaris_gpu.c
index 8b09af6..1951157 100644
--- a/bsd/dev/polaris_gpu.c
+++ b/bsd/dev/polaris_gpu.c
@@ -44,6 +44,8 @@ struct polaris_gpu_context {
 	unsigned int owned;
 };
 
+#define POLARIS_GPU_OWN_CX	(1u << 0)
+
 static struct polaris_gpu_context polaris_gpu = { POLARIS_GPU_OFF, 0, 0 };
 
 /* Written once by the firmware stage; read-only afterwards. */
@@ -57,7 +59,7 @@ static const char *const polaris_gpu_stage_name[POLARIS_GPU_STAGE_COUNT] = {
 /*
  * Only an acquired resource may be released. Resource-specific release
  * callbacks must be installed before ANY power or mapping code is enabled.
- * No stages after the board stage have a backend in this revision.
+ * Only the rails stage has a bounded backend in this revision.
  */
 static bool
 polaris_gpu_enter(struct polaris_gpu_context *ctx, enum polaris_gpu_stage stage)
@@ -80,6 +82,21 @@ polaris_gpu_enter(struct polaris_gpu_context *ctx, enum polaris_gpu_stage stage)
 		/* Validation acquires nothing; owned stays zero. */
 		return true;
 	}
+	if (stage == POLARIS_GPU_RAILS) {
+		/*
+		 * The first hardware stage: only the CX GDSC, only through the
+		 * rails backend, and only when its own opt-in is present. GX
+		 * remains with the GMU; no clock, bus, SMMU or GPU register is
+		 * touched. A refusal claims nothing.
+		 */
+		if (!polaris_gpu_rails_enter()) {
+			printf("POLARIS GPU: rails request refused; no ownership claimed\n");
+			return false;
+		}
+		ctx->owned |= POLARIS_GPU_OWN_CX;
+		ctx->completed++;
+		return true;
+	}
 	if (stage != POLARIS_GPU_BOARD) {
 		printf("POLARIS GPU: %s backend not implemented; no hardware access\n",
 		    polaris_gpu_stage_name[stage]);
@@ -103,7 +120,12 @@ polaris_gpu_unwind(struct polaris_gpu_context *ctx, bool idle_confirmed)
 		printf("POLARIS GPU: idle unconfirmed; quarantined, CPU display unchanged\n");
 		return;
 	}
-	/* No hardware release is permitted while no backend owns a resource. */
+	/* Release only the resources this driver actually acquired, in reverse. */
+	if (ctx->owned & POLARIS_GPU_OWN_CX) {
+		polaris_gpu_rails_exit();
+		ctx->owned &= ~POLARIS_GPU_OWN_CX;
+	}
+	/* No hardware release is permitted for anything without a backend. */
 	if (ctx->owned != 0) {
 		ctx->state = POLARIS_GPU_QUARANTINED;
 		printf("POLARIS GPU: owned resource lacks release backend; quarantined\n");
@@ -159,9 +181,13 @@ polaris_gpu_init(void)
 	if (!polaris_gpu_enter(&polaris_gpu, POLARIS_GPU_RAILS)) {
 		goto fail;
 	}
-	/* Unreachable until individually owned, bounded backends are installed. */
-	polaris_gpu.state = POLARIS_GPU_IDLE;
-	return;
+	/*
+	 * CX is now owned. There is still no clock backend, so the gate must
+	 * refuse here and unwind must release CX in reverse order rather than
+	 * leave an ownerless domain powered.
+	 */
+	(void)polaris_gpu_enter(&polaris_gpu, POLARIS_GPU_CLOCKS);
+	goto fail;
 fail:
 	polaris_gpu_unwind(&polaris_gpu, true);
 	printf("POLARIS GPU: acceleration unavailable; CPU display unchanged\n");
diff --git a/bsd/dev/polaris_gpu_pwr.h b/bsd/dev/polaris_gpu_pwr.h

 		if (after & PG_GDSCR_PWR_ON) {
-			printf("POLARIS PWR: CX PWR_ON after %u polls, GDSCR=0x%08x; "
-			    "rollback = write 0x%08x\n", i + 1, after, before);
-			return;
+			pg_cx_saved = before;
+			pg_cx_owned = 1;
+			printf("POLARIS PWR: rails enter PWR_ON after %u polls "
+			    "GDSCR=0x%08x; CX owned, rollback=0x%08x\n",
+			    i + 1, after, before);

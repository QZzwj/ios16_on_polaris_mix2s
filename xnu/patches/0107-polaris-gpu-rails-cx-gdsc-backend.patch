-void polaris_gpu_cx_on(void);
+
+/*
+ * Rails stage: one controlled CX GDSC request. enter() returns true only when
+ * this driver observed PWR_ON clear before its own write and PWR_ON set after
+ * it. exit() is a no-op unless enter() succeeded and restores the pre-write
+ * register value.
+ */
+int polaris_gpu_rails_enter(void);
+void polaris_gpu_rails_exit(void);
 
 #endif /* _BSD_DEV_POLARIS_GPU_PWR_H_ */
diff --git a/bsd/dev/polaris_gpu_pwron.c b/bsd/dev/polaris_gpu_pwron.c

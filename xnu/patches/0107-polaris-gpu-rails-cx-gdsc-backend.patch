+	before = pg_rd32(pg_cx_regs, PG_CX_GDSCR);
+	printf("POLARIS PWR: rails enter CX GDSCR before=0x%08x (PWR_ON=%u)\n",
 	    before, (before & PG_GDSCR_PWR_ON) != 0);
 	if (before & PG_GDSCR_PWR_ON) {

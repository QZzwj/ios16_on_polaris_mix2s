+/*
+ * CM3 cold boot: copy the 32 KiB legacy GMU image into ITCM and release the
+ * CM3 reset. This is the first stage that writes the GMU register file.
+ *
+ * The sequence mirrors the vendor a6xx_gmu_fw_start()/a6xx_gmu_start() path
+ * for a630 (legacy TCM load, no block header):
+ *   GENERAL_7=1, SYSRESET=1, load ITCM, clear FW_INIT_RESULT, BOOT_CONFIG=2,
+ *   AHB_FENCE_RANGE_0, CM3_CFG=0x4052, SYSRESET=0, poll FW_INIT_RESULT for
+ *   0xBABEFACE. The image itself contains that constant at 0x1AEC/0x2EC0, so
+ * no DTCM mask probe is needed; the vendor mask is all ones.
+ *
+ * Deliberately absent: HFI_QTBL_ADDR/HFI_QTBL_INFO (no queue is built yet),
+ * PWR_COL_CP_MSG (no log IOVA exists), HFI_CTRL_INIT (HFI is a later stage)
+ * and HFI_SFR_ADDR (this tree has no chip-id source). A magic value only
+ * proves the CM3 executed the image; it does not make the GPU usable.
+ *
+ * The firmware page stays mapped: XNU has no ml_io_unmap() counterpart and
+ * the reservation is owned by the handoff for the life of the boot.
+ */
+int
+polaris_gpu_gmu_boot(uint64_t pa, uint32_t size)
+{
+	uint32_t fw0, fw1, fwlast;
+	uint32_t itcm_first, itcm_last;
+	uint32_t boot, cfg, busy, init_result, general7, hfi_status;
+	uint32_t last = 0;
+	unsigned int i;
+	int optin = 0, gpuon = 0;
+	vm_offset_t virt;
+
+	if (!pg_cx_owned || !pg_clk_owned || !pg_bus_owned ||
+	    pg_cx_regs == NULL) {
+		printf("POLARIS PWR: gmu boot refused; bus not owned\n");
+		return 0;
+	}
+	(void)PE_parse_boot_argn("polarisgpuon", &gpuon, sizeof(gpuon));
+	if (gpuon != 1) {
+		printf("POLARIS PWR: gmu boot refused; rails not opted in\n");
+		return 0;
+	}
+	(void)PE_parse_boot_argn("polarisgmuboot", &optin, sizeof(optin));
+	if (optin != 1) {
+		printf("POLARIS PWR: gmu boot not opt-in; CM3 untouched\n");
+		return 0;
+	}
+	if (size != PG_GMU_FW_SIZE) {
+		printf("POLARIS PWR: gmu boot refused; size=%u expected=%u\n",
+		    size, PG_GMU_FW_SIZE);
+		return 0;
+	}
+	if ((pa & (PG_GMU_FW_ALIGN - 1ull)) != 0) {
+		printf("POLARIS PWR: gmu boot refused; pa=0x%llx not page aligned\n",
+		    pa);
+		return 0;
+	}
+	if (!pg_gmu_map()) {
+		return 0;
+	}
+	if (pg_gmu_fw_regs == NULL) {
+		virt = ml_io_map((vm_offset_t)pa, PG_GMU_FW_SIZE);
+		if (virt == 0) {
+			printf("POLARIS PWR: cannot map GMU firmware at 0x%llx; "
+			    "boot skipped\n", pa);
+			return 0;
+		}
+		pg_gmu_fw_regs = (volatile uint32_t *)virt;
+	}
+	fw0 = pg_rd32(pg_gmu_fw_regs, 0);
+	fw1 = pg_rd32(pg_gmu_fw_regs, 4);
+	fwlast = pg_rd32(pg_gmu_fw_regs, (PG_GMU_FW_WORDS - 1u) * 4u);
+	printf("POLARIS PWR: GMU fw pa=0x%llx size=%u word0=0x%08x entry=0x%08x "
+	    "last=0x%08x\n", pa, size, fw0, fw1, fwlast);
+	if ((fw1 & 1u) == 0) {
+		printf("POLARIS PWR: GMU fw entry 0x%08x is not Thumb; "
+		    "loading anyway\n", fw1);
+	}
+
+	/*
+	 * Hold the CM3 in reset while ITCM is rewritten. GENERAL_7 enables
+	 * TCM retention, as the vendor and mainline drivers both do.
+	 */
+	pg_wr32(pg_gmu_regs, PG_GMU_GENERAL_7, 1, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_CM3_SYSRESET, 1, 3);
+	DELAY(1000);
+	for (i = 0; i < PG_GMU_FW_WORDS; i++) {
+		pg_wr32(pg_gmu_regs, (uint32_t)PG_GMU_CM3_ITCM_START + i * 4u,
+		    pg_rd32(pg_gmu_fw_regs, i * 4u), 3);
+	}
+	__sync_synchronize();
+	itcm_first = pg_rd32(pg_gmu_regs, PG_GMU_CM3_ITCM_START);
+	itcm_last = pg_rd32(pg_gmu_regs,
+	    (uint32_t)PG_GMU_CM3_ITCM_START + (PG_GMU_FW_WORDS - 1u) * 4u);
+	printf("POLARIS PWR: GMU ITCM loaded %u words; readback first=0x%08x "
+	    "last=0x%08x\n", PG_GMU_FW_WORDS, itcm_first, itcm_last);
+
+	pg_wr32(pg_gmu_regs, PG_GMU_CM3_FW_INIT_RESULT, 0, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_CM3_BOOT_CONFIG, 0x02u, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_AHB_FENCE_RANGE_0,
+	    (1u << 31) | (0xau << 18) | 0xa0u, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_CM3_CFG, 0x4052u, 3);
+
+	/* Release the CM3 and wait for the image's own init signature. */
+	pg_wr32(pg_gmu_regs, PG_GMU_CM3_SYSRESET, 0, 3);
+	for (i = 0; i < 1000u; i++) {
+		last = pg_rd32(pg_gmu_regs, PG_GMU_CM3_FW_INIT_RESULT);
+		if (last == 0xbabefaceu) {
+			break;
+		}
+		DELAY(100);
+	}
+	if (last != 0xbabefaceu) {
+		for (i = 0; i < 900u; i++) {
+			last = pg_rd32(pg_gmu_regs, PG_GMU_CM3_FW_INIT_RESULT);
+			if (last == 0xbabefaceu) {
+				break;
+			}
+			DELAY(1000);
+		}
+	}
+	if (last != 0xbabefaceu) {
+		pg_wr32(pg_gmu_regs, PG_GMU_CM3_SYSRESET, 1, 3);
+		boot = pg_rd32(pg_gmu_regs, PG_GMU_CM3_BOOT_CONFIG);
+		cfg = pg_rd32(pg_gmu_regs, PG_GMU_CM3_CFG);
+		busy = pg_rd32(pg_gmu_regs, PG_GMU_CM3_FW_BUSY);
+		printf("POLARIS PWR: GMU boot timed out; init=0x%08x boot=0x%08x "
+		    "cfg=0x%08x fw_busy=0x%08x; CM3 held in reset\n",
+		    last, boot, cfg, busy);
+		return 0;
+	}
+	boot = pg_rd32(pg_gmu_regs, PG_GMU_CM3_BOOT_CONFIG);
+	cfg = pg_rd32(pg_gmu_regs, PG_GMU_CM3_CFG);
+	busy = pg_rd32(pg_gmu_regs, PG_GMU_CM3_FW_BUSY);
+	general7 = pg_rd32(pg_gmu_regs, PG_GMU_GENERAL_7);
+	hfi_status = pg_rd32(pg_gmu_regs, PG_GMU_HFI_CTRL_STATUS);
+	init_result = last;
+	printf("POLARIS PWR: GMU boot complete init=0x%08x fw_busy=0x%08x "
+	    "cfg=0x%08x general7=0x%08x hfi_status=0x%08x; HFI not initialized\n",
+	    init_result, busy, cfg, general7, hfi_status);
+	return 1;
+}

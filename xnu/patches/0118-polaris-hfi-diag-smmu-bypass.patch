+	pg_hfi_flush();
+	printf("POLARIS PWR: HFI queue dump %s hdr=%08x/%08x/%08x/%08x/"
+	    "%08x/%08x\n", why, table[0], table[1], table[2], table[3],
+	    table[4], table[5]);

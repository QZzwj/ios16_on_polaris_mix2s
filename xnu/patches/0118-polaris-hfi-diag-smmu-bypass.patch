+/*
+ * Optional bring-up shortcut: route GMU SID 4/5 through the SMMU bypass
+ * path so the CM3 can read the physical HFI queue table before any stage-1
+ * page table exists. This writes only SMR[3]/S2CR[3] (SID 5) and
+ * SMR[4]/S2CR[4] (SID 4); the GPU SIDs stay untouched. It is opt-in because
+ * a wrong SMMU write can wedge the whole GPU power domain.
+ */
+static bool
+pg_hfi_smmu_bypass(void)
+{
+	uint32_t scr0, smr3, smr4, s2cr3, s2cr4;
+	unsigned int i;
+
+	if (!pg_smmu_map()) {
+		return false;
+	}
+	scr0 = pg_rd32(pg_smmu_regs, 0x000u);
+	smr3 = pg_rd32(pg_smmu_regs, PG_SMMU_SMR(3));
+	smr4 = pg_rd32(pg_smmu_regs, PG_SMMU_SMR(4));
+	s2cr3 = pg_rd32(pg_smmu_regs, PG_SMMU_S2CR(3));
+	s2cr4 = pg_rd32(pg_smmu_regs, PG_SMMU_S2CR(4));
+	printf("POLARIS PWR: SMMU bypass before sCR0=0x%08x SMR3=0x%08x "
+	    "SMR4=0x%08x S2CR3=0x%08x S2CR4=0x%08x\n",
+	    scr0, smr3, smr4, s2cr3, s2cr4);
+
+	/* Program the bypass type before making either SMR entry valid. */
+	pg_wr32(pg_smmu_regs, PG_SMMU_S2CR(3),
+	    PG_SMMU_S2CR_TYPE_BYPASS | 0xffu, 3);
+	pg_wr32(pg_smmu_regs, PG_SMMU_S2CR(4),
+	    PG_SMMU_S2CR_TYPE_BYPASS | 0xffu, 3);
+	pg_wr32(pg_smmu_regs, PG_SMMU_SMR(3), PG_SMMU_SMR_VALID | 5u, 3);
+	pg_wr32(pg_smmu_regs, PG_SMMU_SMR(4), PG_SMMU_SMR_VALID | 4u, 3);
+	__sync_synchronize();
+	pg_wr32(pg_smmu_regs, PG_SMMU_TLBIALLNSNH, 1, 3);
+	for (i = 0; i < 100u; i++) {
+		if ((pg_rd32(pg_smmu_regs, PG_SMMU_STLBGSTATUS) & 1u) == 0) {
+			break;
+		}
+		DELAY(10);
+	}
+	printf("POLARIS PWR: SMMU bypass after SMR3=0x%08x SMR4=0x%08x "
+	    "S2CR3=0x%08x S2CR4=0x%08x tlb=0x%08x\n",
+	    pg_rd32(pg_smmu_regs, PG_SMMU_SMR(3)),
+	    pg_rd32(pg_smmu_regs, PG_SMMU_SMR(4)),
+	    pg_rd32(pg_smmu_regs, PG_SMMU_S2CR(3)),
+	    pg_rd32(pg_smmu_regs, PG_SMMU_S2CR(4)),
+	    pg_rd32(pg_smmu_regs, PG_SMMU_STLBGSTATUS));
+	return true;
+}

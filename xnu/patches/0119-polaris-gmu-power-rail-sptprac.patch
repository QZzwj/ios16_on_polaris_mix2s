+/*
+ * Mainline a6xx_gmu_power_config(): disable the GMU WB/RB buffers, program
+ * the power-collapse timing and enable the RPMh GPU client. This runs while
+ * the CM3 is still held in reset, before HFI_CTRL_INIT.
+ */
+static void
+pg_gmu_power_config(void)
+{
+	uint32_t rpmh_before, rpmh_after;
+
+	pg_wr32(pg_gmu_regs, PG_GMU_SYS_BUS_CONFIG, 1, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_ICACHE_CONFIG, 1, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_DCACHE_CONFIG, 1, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_PWR_COL_INTER_FRAME_CTRL,
+	    PG_GMU_PWR_COL_IFPC_CTRL, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_PWR_COL_SPTPRAC_HYST,
+	    PG_GMU_PWR_COL_SPTPRAC_HYST_VAL, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_PWR_COL_INTER_FRAME_CTRL,
+	    PG_GMU_PWR_COL_IFPC_CTRL | PG_GMU_PWR_COL_IFPC_ENABLE |
+	    PG_GMU_PWR_COL_SPTPRAC_ENABLE, 3);
+	rpmh_before = pg_rd32(pg_gmu_regs, PG_GMU_RPMH_CTRL);
+	pg_wr32(pg_gmu_regs, PG_GMU_RPMH_CTRL,
+	    rpmh_before | PG_GMU_RPMH_CTRL_VOTES, 3);
+	rpmh_after = pg_rd32(pg_gmu_regs, PG_GMU_RPMH_CTRL);
+	printf("POLARIS PWR: GMU power cfg bus=0x%08x icache=0x%08x "
+	    "dcache=0x%08x pwr_col=0x%08x rpmh=0x%08x->0x%08x\n",
+	    pg_rd32(pg_gmu_regs, PG_GMU_SYS_BUS_CONFIG),
+	    pg_rd32(pg_gmu_regs, PG_GMU_ICACHE_CONFIG),
+	    pg_rd32(pg_gmu_regs, PG_GMU_DCACHE_CONFIG),
+	    pg_rd32(pg_gmu_regs, PG_GMU_PWR_COL_INTER_FRAME_CTRL),
+	    rpmh_before, rpmh_after);
+}
+
+/*
+ * Mainline a6xx_gmu_gfx_rail_on(): select the default GX/MX vote and ask the
+ * GMU to bring the GX rail up through the legacy BOOT_SLUMBER OOB handshake
+ * (HOST2GMU bit 22, GMU2HOST ack bit 30). We have no OPP/ARC table yet, so
+ * vote index 0 is used; the ack is diagnostic and a timeout does not abort
+ * the HFI attempt.
+ */
+static bool
+pg_gmu_gfx_rail_on(void)
+{
+	uint32_t info = 0;
+	unsigned int i;
+
+	pg_wr32(pg_gmu_regs, PG_GMU_BOOT_SLUMBER_OPTION, 0, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_GX_VOTE_IDX, 0, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_MX_VOTE_IDX, 0, 3);
+	pg_wr32(pg_gmu_regs, PG_GMU_HOST2GMU_INTR_SET, 1u << 22, 3);
+	for (i = 0; i < 20u; i++) {
+		info = pg_rd32(pg_gmu_regs, PG_GMU_GMU2HOST_INTR_INFO);
+		if ((info & (1u << 30)) != 0) {
+			break;
+		}
+		DELAY(1000);
+	}
+	pg_wr32(pg_gmu_regs, PG_GMU_GMU2HOST_INTR_CLR, 1u << 30, 3);
+	printf("POLARIS PWR: GMU gfx rail OOB option=%u gx=%u mx=%u "
+	    "ack=%u info=0x%08x\n",
+	    pg_rd32(pg_gmu_regs, PG_GMU_BOOT_SLUMBER_OPTION),
+	    pg_rd32(pg_gmu_regs, PG_GMU_GX_VOTE_IDX),
+	    pg_rd32(pg_gmu_regs, PG_GMU_MX_VOTE_IDX),
+	    (info & (1u << 30)) != 0, info);
+	return (info & (1u << 30)) != 0;
+}
+
+/*
+ * Mainline a6xx_sptprac_enable(): for A630 the CPU, not the GMU, owns SPTP
+ * power collapse, so GX_SPTPRAC_POWER_CONTROL must be written and the
+ * SPTPRAC clock status polled to 0x28 before HFI starts.
+ */
+static bool
+pg_gmu_sptprac_enable(void)
+{
+	uint32_t status = 0;
+	unsigned int i;
+
+	pg_wr32(pg_gmu_regs, PG_GMU_GX_SPTPRAC_POWER_CONTROL,
+	    PG_GMU_SPTPRAC_POWER_ON, 3);
+	for (i = 0; i < 100u; i++) {
+		status = pg_rd32(pg_gmu_regs, PG_GMU_SPTPRAC_PWR_CLK_STATUS);
+		if ((status & PG_GMU_SPTPRAC_STATUS_MASK) ==
+		    PG_GMU_SPTPRAC_STATUS_ON) {
+			break;
+		}
+		DELAY(1000);
+	}
+	printf("POLARIS PWR: GMU SPTPRAC control=0x%08x status=0x%08x %s\n",
+	    pg_rd32(pg_gmu_regs, PG_GMU_GX_SPTPRAC_POWER_CONTROL), status,
+	    ((status & PG_GMU_SPTPRAC_STATUS_MASK) ==
+	    PG_GMU_SPTPRAC_STATUS_ON) ? "on" : "timeout");
+	return (status & PG_GMU_SPTPRAC_STATUS_MASK) ==
+	    PG_GMU_SPTPRAC_STATUS_ON;
+}

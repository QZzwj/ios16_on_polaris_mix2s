@@ -997,15 +1000,67 @@ polaris_gpu_gmu_enter(void)
 static uint32_t
 pg_smmu_read(uint32_t off, unsigned int level)
 {
+	uint32_t value;
+
 	printf("POLARIS PWR: SMMU read begin off=0x%03x level=%u\n", off, level);
 	sweet_log_sync();
-	return pg_rd32(pg_smmu_regs, off);
+	value = pg_rd32(pg_smmu_regs, off);
+	printf("POLARIS PWR: SMMU read value off=0x%03x level=%u value=0x%08x\n",
+	    off, level, value);
+	return value;
+}
+
+/*
+ * Comma-separated hex offsets, e.g. polarissmmusk=024,028,800,c00. Each
+ * read is flushed to the last-words block first, so the final begin line
+ * names the exact offset that did not answer.
+ */
+static void
+pg_smmu_scan(const char *spec)
+{
+	while (*spec != '\0') {
+		uint32_t off = 0;
+		unsigned int digits = 0;
+
+		while (*spec != '\0' && *spec != ',') {
+			char c = *spec++;
+			uint32_t d;
+
+			if (c >= '0' && c <= '9') {
+				d = (uint32_t)(c - '0');
+			} else if (c >= 'a' && c <= 'f') {
+				d = (uint32_t)(c - 'a') + 10u;
+			} else if (c >= 'A' && c <= 'F') {
+				d = (uint32_t)(c - 'A') + 10u;
+			} else if (c == 'x' || c == 'X') {
+				continue;
+			} else {
+				break;
+			}
+			off = (off << 4) | d;
+			digits++;
+		}
+		if (*spec == ',') {
+			spec++;
+		}
+		if (digits == 0) {
+			break;
+		}
+		if (off >= PG_SMMU_WINDOW) {
+			printf("POLARIS PWR: SMMU scan skip off=0x%x outside window\n",
+			    off);
+			continue;
+		}
+		(void)pg_smmu_read(off, 9);
+	}
+	printf("POLARIS PWR: SMMU scan complete\n");
 }
 

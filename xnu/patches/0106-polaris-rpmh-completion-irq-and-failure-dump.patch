diff --git a/bsd/dev/polaris_rpmh.c b/bsd/dev/polaris_rpmh.c
index 01ce739..4f71f60 100644
--- a/bsd/dev/polaris_rpmh.c
+++ b/bsd/dev/polaris_rpmh.c
@@ -113,6 +113,33 @@ rh_quiescent(const struct pg_rh_snapshot *snapshot)
 	return true;
 }
 
+static void
+rh_print_failure(const struct pg_rh_snapshot *snapshot)
+{
+	unsigned int bank, cmd;
+
+	printf("POLARIS RPMH: failure snapshot IRQ_EN=0x%x IRQ_STATUS=0x%x\n",
+	    snapshot->irq_enabled, snapshot->irq_status);
+	for (bank = 0; bank < PG_RH_ACTIVE; bank++) {
+		const struct pg_rh_slot *slot = &snapshot->slot[bank];
+
+		printf("POLARIS RPMH: TCS%u status=0x%x control=0x%x "
+		    "enable=0x%x wait=0x%x\n", bank, slot->idle, slot->control,
+		    slot->enabled, slot->wait);
+		for (cmd = 0; cmd < snapshot->commands; cmd++) {
+			if (!(slot->enabled & (1u << cmd)) &&
+			    !slot->cmd_status[cmd] && !slot->msgid[cmd] &&
+			    !slot->addr[cmd] && !slot->data[cmd]) {
+				continue;
+			}
+			printf("POLARIS RPMH: TCS%u cmd%u msg=0x%x addr=0x%x "
+			    "data=0x%x status=0x%x\n", bank, cmd,
+			    slot->msgid[cmd], slot->addr[cmd], slot->data[cmd],
+			    slot->cmd_status[cmd]);
+		}
+	}
+}
+
 int
 polaris_rpmh_vote_gfx(unsigned int selector)
 {
@@ -167,6 +194,11 @@ polaris_rpmh_vote_gfx(unsigned int selector)
 	if (result != PG_RH_OK) {
 		printf("POLARIS RPMH: vote did not ACK; transport quarantined=%d\n",
 		    rh_transport.quarantined);
+		if (pg_rh_snapshot(&io, &after) == PG_RH_OK) {
+			rh_print_failure(&after);
+		} else {
+			printf("POLARIS RPMH: failure snapshot unreadable\n");
+		}
 		return result;
 	}
 	result = pg_rh_snapshot(&io, &after);

diff --git a/bsd/dev/polaris_gpu_arc.c b/bsd/dev/polaris_gpu_arc.c
new file mode 100644
index 0000000..decc40b
--- /dev/null
+++ b/bsd/dev/polaris_gpu_arc.c
@@ -0,0 +1,54 @@
+/*
+ * Polaris A630 command-DB facts as compiled-in data (read-only observation,
+ * 2026-10-28, /sys/kernel/debug/cmd_db on this handset's recovery kernel).
+ *
+ * This is deliberately inert: it powers nothing, maps nothing and votes nothing.
+ * It exists so later stages have the ARC/BCM addresses and the SID->context-bank
+ * routing in one place, and so a diagnostic line can state what was pinned.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <dev/polaris_gpu_arc.h>
+
+static const struct pg_arc_row pg_arc_rows_data[] = {
+	{ "cx.lvl",  0x30000, 7 },
+	{ "mx.lvl",  0x30010, 4 },
+	{ "gfx.lvl", 0x30050, 9 },	/* 9 indices vs 7 KGSL frequencies */
+	{ "ddr.lvl", 0x30070, 3 },
+	{ "xo.lvl",  0x30080, 3 },
+	{ "vrm.cx",  0x40800, 0 },
+	{ "vrm.mx",  0x40700, 0 },
+	{ "vrm.gfx", 0x42700, 0 },
+	{ "vrm.ebi", 0x40400, 0 },
+	{ "MC0",     0x50000, 0 },
+};
+
+static const struct pg_sid_map pg_arc_sids_data[] = {
+	{ 0x208, 0x0, "gfx3d_user" },
+	{ 0x208, 0x1, "gfx3d_secure" },
+	{ 0x208, 0x2, "gfx3d_secure" },
+	{ 0x208, 0x4, "gmu_user" },
+	{ 0x208, 0x5, "gmu_kernel" },
+};
+
+const struct pg_arc_row *
+pg_arc_rows(unsigned int *count)
+{
+	if (count != NULL) {
+		*count = sizeof(pg_arc_rows_data) / sizeof(pg_arc_rows_data[0]);
+	}
+	return pg_arc_rows_data;
+}
+
+const struct pg_sid_map *
+pg_arc_sid_map(unsigned int *count)
+{
+	if (count != NULL) {
+		*count = sizeof(pg_arc_sids_data) / sizeof(pg_arc_sids_data[0]);
+	}
+	return pg_arc_sids_data;
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/polaris_gpu_arc.h b/bsd/dev/polaris_gpu_arc.h
new file mode 100644
index 0000000..6d29553
--- /dev/null
+++ b/bsd/dev/polaris_gpu_arc.h
@@ -0,0 +1,34 @@
+/*
+ * Polaris A630 command-DB facts, as compiled-in data. No MMIO, no blob mapping,
+ * no clock or rail votes: this file only carries what we observed read-only on
+ * this handset and answers questions about it.
+ *
+ * The command DB itself is data captured from /sys/kernel/debug/cmd_db (0444) on
+ * the recovery kernel (2026-10-28). Content validation lives at packaging time in
+ * tools/polaris_cmddb.py, because XNU would otherwise have to map the payload blob,
+ * and 0092 was withdrawn precisely for mapping command-DB memory on an unproven
+ * ownership claim.
+ */
+#ifndef _BSD_DEV_POLARIS_GPU_ARC_H_
+#define _BSD_DEV_POLARIS_GPU_ARC_H_
+
+#include <sys/types.h>
+
+/* One command-DB row we pinned from the handset. */
+struct pg_arc_row {
+	const char *id;
+	uint32_t addr;
+	uint32_t levels;	/* non-zero VLVL indices the dump showed */
+};
+
+/* SID -> context bank, from the vendor device tree on this handset. */
+struct pg_sid_map {
+	uint32_t sid;
+	uint32_t mask;
+	const char *role;
+};
+
+const struct pg_arc_row *pg_arc_rows(unsigned int *count);
+const struct pg_sid_map *pg_arc_sid_map(unsigned int *count);
+
+#endif /* _BSD_DEV_POLARIS_GPU_ARC_H_ */
